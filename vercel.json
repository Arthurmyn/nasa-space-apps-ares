{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "landing": {
      "root": "landing",
      "framework": "vite"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "functions": {
        "app/main.py": {
          "includeFiles": "data/gale-bx/**"
        }
      }
    }
  },
  "redirects": [
    {
      "source": "/app",
      "destination": "/app/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/app/(.*)",
      "destination": { "service": "frontend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "landing" }
    }
  ]
}
