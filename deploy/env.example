# Copy to /srv/ares/.env on the server. Not committed: .env is gitignored.

# Public domain. Leave it commented out to serve plain HTTP on the server IP.
# With it set, Caddy issues a TLS certificate. After a change: sudo systemctl restart caddy
#DOMAIN=ares.example.com

APP_ENV=production

# Must match the address users open in the browser (scheme + host, no trailing slash).
CORS_ORIGINS=http://79.76.39.80

# Do not set VITE_API_URL: the production build calls /api/v1 on the same origin.
